# ============================================
# CIVICPULSE ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git

# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host:5432/civicpulse?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (for NextAuth Google Provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Aadhaar Hashing Salt (never share)
AADHAAR_SALT="change-this-to-random-string"

# CivicPulse HMAC Signing Secret
CIVICPULSE_API_SECRET="change-this-to-random-string"

# API Setu (MeitY / iSPIRT)
APISETU_API_KEY=""

# DigiLocker
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""

# Razorpay (Sandbox mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# data.gov.in
DATA_GOV_IN_API_KEY=""

# Bhashini Translation API
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""

# Mock API Toggle (true for development, false for production)
USE_MOCK_APIS="true"
